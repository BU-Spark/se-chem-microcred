# Copy to .env (Prisma + Next) / .env.local (Next only, overrides .env).

# Database. Use a local or staging database for development, never prod.
DATABASE_URL=postgresql://postgres:dev@localhost:5432/chemskills

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Feature flags
NEXT_PUBLIC_HOME_TABS=
NEXT_PUBLIC_CURRENT_ENVIRONMENT_DEV=

# Email (Resend, issue #323). Without RESEND_API_KEY or EMAIL_FROM, emails are
# logged and recorded as SKIPPED instead of being sent.
RESEND_API_KEY=
# A verified Resend domain, e.g. "Chem Skills <noreply@your-domain>". For local
# testing before DNS is set up: onboarding@resend.dev (delivers only to the
# Resend account owner's address).
EMAIL_FROM=
# Base for links in emails.
APP_BASE_URL=http://localhost:3000

# Shared secret for POST /api/cron/feedback-reminders (sent as a Bearer token
# by the Railway cron service).
CRON_SECRET=
